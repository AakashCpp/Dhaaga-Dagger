NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dhaaga_dagger
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# Firebase Admin SDK (customer Google authentication)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin email OTP. Only this exact address can enter the admin panel.
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_OTP_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_SECRET=replace-with-another-long-random-secret
ADMIN_OTP_MINUTES=10

# Use "console" only for local development. Production requires "smtp".
# For Gmail, SMTP_PASS must be a Google App Password, not the account password.
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-admin@gmail.com
SMTP_PASS=
MAIL_FROM="Dhaaga & Dagger <your-admin@gmail.com>"

# Product images: local for development, cloudinary for production
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
