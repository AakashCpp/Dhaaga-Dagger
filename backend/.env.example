NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dhaaga_dagger
CLIENT_ORIGINS=https://dhaaga-dagger.vercel.app/

# Firebase Admin SDK (customer Google authentication)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin email OTP. Only this exact address can enter the admin panel.
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_OTP_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_SECRET=replace-with-another-long-random-secret
ADMIN_OTP_EXPIRY_MINUTES=10

# Customer order verification. Keep these different from the admin secrets.
ORDER_OTP_SECRET=replace-with-a-third-long-random-secret
ORDER_TOKEN_SECRET=replace-with-a-fourth-long-random-secret
ORDER_OTP_EXPIRY_MINUTES=10
ORDER_TOKEN_EXPIRY_MINUTES=15

# Use "console" only for local development. Production requires "smtp".
# For Gmail, SMTP_PASS must be a Google App Password, not the account password.
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-admin@gmail.com
SMTP_PASS=
MAIL_FROM="Dhaaga & Dagger <your-admin@gmail.com>"

# Product images are uploaded by the authenticated backend to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
